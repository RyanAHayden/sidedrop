PUBLIC_URL=https://sidedrop.example.com
# Leave the rest empty to set them up on your iPhone: sign in with the default password, sidedrop, and the setup screen asks for them.
# Anything filled in here wins over the setup screen; with PASSWORD set there is no setup screen.
PASSWORD=   # a long passphrase for friends
ADMIN_PASSWORD=   # optional, a different long passphrase; unlocks More → Manage (disable iPhones)
SECRET_KEY=   # optional, python3 -c 'import secrets;print(secrets.token_hex(32))'; empty = one made and kept in the data folder
ASC_KEY_ID=
ASC_ISSUER_ID=
BUNDLE_ID=   # com.yourname.*: apps outside it are re-IDed to fit (com.other.app -> com.yourname.app); an explicit App ID with Push keeps bundle IDs and push
P12_PASSWORD=
SOURCES=https://github.com/you/app/releases/latest/download/altstore-source.json   # optional, space-separated AltStore sources to mirror
SYNC_TOKEN=   # optional, CI sends "Authorization: Bearer <token>" to POST /sync after a release
PROFILE_CERT_DIR=   # optional, dir with fullchain.pem + privkey.pem (e.g. NPM letsencrypt live/npm-N) so iOS shows the profile as Verified
